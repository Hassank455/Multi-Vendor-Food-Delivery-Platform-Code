{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "CommonJS",
    "target": "ES2023",

    "esModuleInterop": true,

    "strict": true,

    "sourceMap": true,
    "skipLibCheck": true,

    "types": ["node"]
  },

  "include": ["src"],
  "exclude": [
    "node_modules",
    // Keep feature-based test files out of the production build output.
    "src/**/*.unit.spec.ts",
    "src/**/*.int.spec.ts"
  ],
  "ts-node": {
    "files": true
  }
}
