generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------------------------------
//                                           ENUMS
//------------------------------------------------------------------------------------------------------


enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

// ───────────────────────────────────────────────────────────────────────────────────────────────────────

enum CartEventType {
  ITEM_ADDED
  ITEM_REMOVED
  CART_CLEARED
  CART_CHECKED_OUT
}

// ───────────────────────────────────────────────────────────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  CARD
}

// ───────────────────────────────────────────────────────────────────────────────────────────────────────

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

// ───────────────────────────────────────────────────────────────────────────────────────────────────────

enum RoleEnum {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
  RESTAURANT_OWNER
}

// ───────────────────────────────────────────────────────────────────────────────────────────────────────

enum AuthCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
 // PHONE_VERIFICATION
 // LOGIN_OTP
}

// ───────────────────────────────────────────────────────────────────────────────────────────────────────

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  password        String
  role            RoleEnum  @default(CUSTOMER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isActive        Int       @default(1)

  customer   Customer?
  restaurant Restaurant?
  authCodes AuthCode[]
  refreshTokens RefreshToken[]
}

// ───────────────────────────────────────────────────────────────────────────────────────────────────────

model Customer {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique 
  phone     String
  gender    String?

  paymentPreference PaymentMethod?
  
  user      User           @relation(fields: [userId], references: [id])
  cart      Cart?
  orders    Order[]
  reviews   Review[]
  customerAddresses CustomerAddress[]
}

// ───────────────────────────────────────────────────────────────────────────────────────────────────────

// Stores temporary auth codes for email verification and password reset.
// Codes expire after a short time and are marked as consumed once used.
model AuthCode {
  id         Int             @id @default(autoincrement())   // Unique code record ID
  userId     Int                                             // User who owns this code
  purpose    AuthCodePurpose                                 // Why this code was issued
  codeHash   String                                          // Hashed OTP or reset code
  expiresAt  DateTime                                        // Expiration time
  consumedAt DateTime?                                       // Set when the code is used
  createdAt  DateTime        @default(now())                 // Creation timestamp

  user User @relation(fields: [userId], references: [id])
}

// ───────────────────────────────────────────────────────────────────────────────────────────────────────

model RefreshToken {
  id               Int      @id @default(autoincrement())     // Unique refresh token record ID used inside the refresh token payload
  userId           Int                                        // The user who owns this refresh token
  refreshTokenHash String?                                    // Hashed refresh token value, stored after the token is issued
  expiresAt        DateTime                                   // When this refresh token expires
  revokedAt        DateTime?                                  // Set when this refresh token is revoked or invalidated
  createdAt        DateTime @default(now())                   // When this refresh token record was created

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ───────────────────────────────────────────────────────────────────────────────────────────────────────

model CustomerAddress {
  id          Int     @id @default(autoincrement())
  customerId  Int
  street      String
  city        String
  buildingNo  String?
  postalCode  String? // Not important!
  governorate String
  deletedAt   DateTime?

  customer Customer @relation(fields: [customerId], references: [id])

  orders Order[]
}

model Restaurant {
  id      Int         @id @default(autoincrement())
  name    String
  phone   String?
  address String?
  ownerId Int         @unique
  rating  Float       @default(0)
  isEnabled Boolean   @default(true)
  createdAt DateTime  @default(now())

  owner User @relation(fields: [ownerId], references: [id])

  menuItems      MenuItem[]
  menuCategories MenuCategory[]
  reviews        Review[]
  discountCodes  DiscountCode[]
  orders         Order[]
  carts          Cart[]
}

model MenuItem {
  id           Int     @id @default(autoincrement())
  name         String
  description  String
  restaurantId Int
  categoryId   Int
  price        Decimal @db.Decimal(10, 2)
  isAvailable  Boolean @default(true)
  deletedAt    DateTime?

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id])
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model MenuCategory {
  id           Int     @id @default(autoincrement())
  name         String
  restaurantId Int
  isActive     Boolean @default(true)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  menuItems MenuItem[]

  @@unique([restaurantId, name])
}

model Review {
  id           Int     @id @default(autoincrement())
  customerId   Int
  restaurantId Int
  orderId      Int     @unique
  rating       Float
  comment      String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  order      Order      @relation(fields: [orderId], references: [id])
  customer   Customer?  @relation(fields: [customerId], references: [id])

  @@index([customerId, restaurantId])
}

model Cart {
  id           Int         @id @default(autoincrement())
  customerId   Int         @unique
  restaurantId Int?
  subTotal     Decimal     @default(0) @db.Decimal(10, 2)
  customer     Customer    @relation(fields: [customerId], references: [id])
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  items      CartItem[]
  cartEvents CartEvent[]

  @@index([restaurantId])
}

model CartEvent {
  id        Int           @id @default(autoincrement())
  cartId    Int           @map("cart_id")
  eventType CartEventType @map("event_type")
  eventData Json?         @map("event_data")
  timestamp DateTime      @default(now())

  cart Cart @relation(fields: [cartId], references: [id])

  @@index([cartId])
}

model CartItem {
  id         Int   @id @default(autoincrement())
  cartId     Int   @map("cart_id")
  menuItemId Int   @map("menu_item_id")
  quantity   Int   @default(1)
  price      Decimal @db.Decimal(10, 2)

  cart     Cart     @relation(fields: [cartId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([cartId, menuItemId])
}

model Order {
  id                 Int           @id @default(autoincrement())
  customerId         Int
  customerAddressId  Int
  restaurantId       Int
  status             OrderStatus   @default(PENDING)
  createdAt          DateTime      @default(now())
  paymentMethod      PaymentMethod
  totalPrice         Decimal @db.Decimal(10, 2)
  discountPercentage Float?
  priceAfterDiscount Decimal? @db.Decimal(10, 2) // Not really needed, can be calculated on the fly

  customerAddress CustomerAddress @relation(fields: [customerAddressId], references: [id])
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id])

  review       Review?
  items        OrderItem[]
  transactions Transaction[]
  customer     Customer? @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt(sort: Desc)])
  @@index([restaurantId, createdAt(sort: Desc)])
}

model OrderItem {
  id         Int   @id @default(autoincrement())
  orderId    Int   @map("order_id")
  menuItemId Int   @map("menu_item_id")
  quantity   Int   @map("quantity")
  price      Decimal @db.Decimal(10, 2) @map("snapshot_price")

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([orderId, menuItemId])
}

model DiscountCode {
  id                 Int      @id @default(autoincrement())
  code               String   @unique
  restaurantId       Int
  discountPercentage Float
  //TODO: Should we use limitAwarded or expiresAt? Maybe both?
  // limitAwarded       Int
  // awardedCount       Int      @default(0)
  expiresAt          DateTime
  isActive           Boolean  @default(true) // Not really needed, can be determined by expiresAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
}



// Transaction?
model Transaction {
  id        Int               @id @default(autoincrement())
  orderId   Int
  amount    Decimal @db.Decimal(10, 2)
  method    PaymentMethod
  details   String?
  status    TransactionStatus @default(PENDING)
  createdAt DateTime          @default(now())

  order           Order            @relation(fields: [orderId], references: [id])
  transactionLogs TransactionLog[]
}

model TransactionLog {
  id            Int               @id @default(autoincrement())
  transactionId Int
  status        TransactionStatus
  timestamp     DateTime          @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
}
